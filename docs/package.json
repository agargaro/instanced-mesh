{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsc --project tsconfig.build.json & astro dev --host",
    "start": "tsc --project tsconfig.build.json & astro dev",
    "build": "tsc --project tsconfig.build.json & astro check && astro build",
    "preview": "astro preview --port 4321",
    "previews": "BASE_URL=http://localhost:4321 node scripts/generate-previews.mjs",
    "update-previews": "npm run build && npm run preview & sleep 2 && npm run previews",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/starlight": "^0.42.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@stackblitz/sdk": "^1.11.1",
    "@three.ez/instanced-mesh": "^0.3.1",
    "@three.ez/main": "latest",
    "astro": "^7.3.3",
    "astro-auto-import": "^0.6.0",
    "sharp": "^0.35.4",
    "starlight-typedoc": "^0.23.1",
    "three": "~0.172.0",
    "tweakpane": "^4.0.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "~5.7.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/three": "~0.171.0"
  }
}

---
import itemsJson from "../../data/examples.manifest.json";
import { existsSync } from "node:fs";
import path from "node:path";

type ExampleItem = {
  slug: string;
  title: string;
  url: string;
  posterJpg?: string;
  animWebp?: string;
  category?: string;
  posterFlat?: boolean;
};

const base = import.meta.env.BASE_URL;
const publicDir = path.join(process.cwd(), "public");

function publicFile(url?: string): string | undefined {
  if (!url) return undefined;
  const rel = url.startsWith(base) ? url.slice(base.length) : url.replace(/^\/+/, "");
  return path.join(publicDir, rel);
}

async function posterIsFlat(url?: string): Promise<boolean> {
  const file = publicFile(url);
  if (!file || !existsSync(file)) return true;
  try {
    const { default: sharp } = await import("sharp");
    const stats = await sharp(file).stats();
    return (stats.entropy ?? 0) < 1;
  } catch {
    return false;
  }
}

const items: ExampleItem[] = await Promise.all(
  (itemsJson as ExampleItem[]).map(async (item) => ({ ...item, posterFlat: await posterIsFlat(item.posterJpg) }))
);

const categories: Record<string, ExampleItem[]> = {};
for (const item of items) {
  const cat = item.category || "examples";
  (categories[cat] ??= []).push(item);
}
const categoryEntries: [string, ExampleItem[]][] = Object.entries(categories);
const categoryCount = categoryEntries.length;
---

<section class="examples" aria-label="Examples">
  <header class="examples-head">
        <p class="examples-note">
      {items.length} live scenes, one per capability — every one is real, running code. Filter, then open one in
      the viewer or in its own sheet.
    </p>
    <div class="examples-controls">
      <div class="examples-filters" role="group" aria-label="Filter by category">
        <button type="button" class="chip" data-category="all" aria-pressed="true">All <span>{items.length}</span></button>
        {
          categoryEntries.map(([cat, arr]) => (
            <button type="button" class="chip" data-category={cat} aria-pressed="false">
              {cat} <span>{arr.length}</span>
            </button>
          ))
        }
      </div>
      <label class="examples-search" for="example-search">
        <span class="visually-hidden">Search examples</span>
        <input
          type="search"
          id="example-search"
          aria-label="Search examples"
          placeholder="SEARCH"
          autocomplete="off"
          spellcheck="false"
        />
      </label>
    </div>
  </header>

  <div class="examples-grid" id="examples-grid">
    {
      categoryEntries.map(([cat, arr]) =>
        arr.map((item) => (
          <article class="plate" data-category={cat} data-title={`${item.title} ${item.slug}`.toLowerCase()}>
            <button type="button" class="plate-open" data-url={item.url} data-title={item.title} aria-label={`Open example: ${item.title}`}>
              <span class="plate-cover">
                {item.posterJpg && (!item.posterFlat || item.animWebp) ? (
                  <img
                    class="plate-poster"
                    src={item.posterJpg}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="400"
                    height="250"
                    data-base={item.posterFlat ? undefined : "true"}
                  />
                ) : null}
                {item.animWebp ? (
                  <img
                    class={item.posterFlat ? "plate-base" : "plate-anim"}
                    src={item.animWebp}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="400"
                    height="250"
                    data-base={item.posterFlat ? "true" : undefined}
                  />
                ) : null}
                <span class="plate-fallback" aria-hidden="true">
                  <span class="plate-fallback-title">{item.title}</span>
                  <span class="plate-fallback-slug">{item.slug}</span>
                </span>
              </span>
              <span class="plate-meta">
                <span class="plate-title">{item.title}</span>
                <span class="plate-slug">{item.slug}</span>
              </span>
            </button>
            <a class="plate-sheet" href={item.url} aria-label={`Open ${item.title} in its own page`}>SHEET ↗</a>
          </article>
        ))
      )
    }
  </div>

  <p class="examples-empty" id="examples-empty" role="status" hidden>No example matches that filter.</p>
</section>

<dialog id="example-viewer" aria-label="Example viewer">
  <div class="viewer-bar">
    <span class="viewer-title" id="viewer-title">Example</span>
    <a class="viewer-sheet" id="viewer-sheet" href="#" target="_blank" rel="noreferrer">OPEN SHEET ↗</a>
    <button type="button" class="viewer-close" id="viewer-close" aria-label="Close the viewer">CLOSE ✕</button>
  </div>
  <iframe id="viewer-frame" title="Example preview" loading="lazy"></iframe>
</dialog>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .examples {
    max-width: 78rem;
    margin-inline: auto;
    padding: 1.5rem var(--sl-content-pad-x) 3rem;
  }

  .examples-head {
    border-bottom: 3px solid var(--sd-ink);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  .examples-head h2 {
    margin: 0;
    font: 400 clamp(2rem, 8.2vw, 2.6rem) / 0.98 var(--sd-display);
    letter-spacing: 0.005em;
    font-synthesis: none;
    text-transform: uppercase;
  }

  .examples-note {
    max-width: 52ch;
    margin: 0.5rem 0 1rem;
    color: var(--sd-ink-soft);
    font-size: 0.9375rem;
  }

  .examples-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    justify-content: space-between;
  }

  .examples-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--sd-frame-soft);
    background: var(--sd-paper-raised);
    color: var(--sd-ink-soft);
    font: 700 0.6875rem/1 var(--sl-font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .chip span {
    color: var(--sd-ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .chip:hover {
    border-color: var(--sd-ink);
    color: var(--sd-ink);
  }

  .chip[aria-pressed='true'] {
    background: var(--sd-ink);
    border-color: var(--sd-ink);
    color: var(--sd-paper-raised);
  }

  .chip[aria-pressed='true'] span {
    color: var(--sd-frame-soft);
  }

  .chip:focus-visible,
  .plate-open:focus-visible,
  .plate-sheet:focus-visible,
  .viewer-close:focus-visible {
    outline: 2px solid var(--sd-cel-red);
    outline-offset: 2px;
  }

  .examples-search input {
    width: 12rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--sd-frame-soft);
    background: var(--sd-paper-raised);
    color: var(--sd-ink);
    font: 700 0.6875rem/1 var(--sl-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .examples-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1px;
    background: var(--sd-frame-soft);
    border: 1px solid var(--sd-frame-soft);
  }

  .plate {
    position: relative;
    background: var(--sd-paper-raised);
  }

  .plate-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: start;
    cursor: pointer;
  }

  .plate-cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--sd-paper-sunk);
    border-bottom: 1px solid var(--sd-frame-soft);
  }

  .plate-cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Starlight's flow spacing (.sl-markdown-content :not(...) + :not(...)) outranks
     the rule above, so the stacked animation used to fade in 1rem low. Pin every
     stacked preview to the same box so the hover swap cannot shift the crop. */
  .plate-cover img:not(:only-child) {
    margin: 0;
  }

  /* The hover preview is a swap, not a buried raster: the frame is hidden
     with visibility (opacity stays 1) and revealed on hover/focus. */
  .plate-anim {
    visibility: hidden;
    transition: visibility 0s linear 180ms;
  }

  .plate-open:hover .plate-anim,
  .plate-open:focus-visible .plate-anim {
    visibility: visible;
    transition-delay: 0s;
  }

  .plate-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.7rem 0.8rem;
  }

  .plate-title {
    font: 400 1.1rem/1.1 var(--sd-display);
    letter-spacing: 0.01em;
    font-synthesis: none;
    text-transform: uppercase;
    color: var(--sd-ink-strong);
  }

  .plate-slug {
    font: 400 0.6875rem/1 var(--sl-font-mono);
    letter-spacing: 0.05em;
    color: var(--sd-ink-soft);
  }

  .plate-sheet {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.3rem 0.45rem;
    background: var(--sd-paper-raised);
    border: 1px solid var(--sd-ink);
    color: var(--sd-ink);
    font: 700 0.6875rem/1 var(--sl-font-mono);
    letter-spacing: 0.12em;
    text-decoration: none;
    opacity: 0;
    transition: opacity 140ms linear;
  }

  .plate:hover .plate-sheet,
  .plate:focus-within .plate-sheet {
    opacity: 1;
  }

  .examples-empty {
    padding: 2rem 0;
    color: var(--sd-ink-faint);
    font: 700 0.6875rem/1 var(--sl-font-mono);
    letter-spacing: 0.05em;
  }

  #example-viewer {
    width: min(96vw, 84rem);
    height: min(88vh, 60rem);
    padding: 0;
    border: 1px solid var(--sd-ink);
    background: var(--sd-paper);
    color: var(--sd-ink);
  }

  #example-viewer::backdrop {
    background: rgba(0, 0, 0, 0.48);
  }

  .viewer-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0.6rem;
    border-bottom: 2px solid var(--sd-cel-red);
  }

  .viewer-title {
    font: 400 1.1rem/1 var(--sd-display);
    letter-spacing: 0.01em;
    font-synthesis: none;
    text-transform: uppercase;
  }

  .viewer-sheet,
  .viewer-close {
    margin-inline-start: auto;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--sd-ink);
    background: var(--sd-paper-raised);
    color: var(--sd-ink);
    font: 700 0.6875rem/1 var(--sl-font-mono);
    letter-spacing: 0.12em;
    text-decoration: none;
    cursor: pointer;
  }

  .viewer-close {
    margin-inline-start: 0;
  }

  #viewer-frame {
    width: 100%;
    height: calc(100% - 2.75rem);
    border: 0;
    background: var(--sd-paper-sunk);
  }

  @media (prefers-reduced-motion: reduce) {
    .plate-anim,
    .plate-sheet {
      transition: none;
    }
  }
</style>

<script>
  const grid = document.getElementById("examples-grid");
  const plates = Array.from(grid?.querySelectorAll<HTMLElement>(".plate") ?? []);
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".chip"));
  const search = document.getElementById("example-search") as HTMLInputElement | null;
  const empty = document.getElementById("examples-empty");
  const viewer = document.getElementById("example-viewer") as HTMLDialogElement | null;
  const frame = document.getElementById("viewer-frame") as HTMLIFrameElement | null;
  const viewerTitle = document.getElementById("viewer-title");
  const viewerSheet = document.getElementById("viewer-sheet") as HTMLAnchorElement | null;
  const viewerClose = document.getElementById("viewer-close");

  let category = "all";
  let query = "";

  function apply(): void {
    let visible = 0;
    for (const plate of plates) {
      const matchCategory = category === "all" || plate.dataset.category === category;
      const matchQuery = query === "" || (plate.dataset.title ?? "").includes(query);
      const show = matchCategory && matchQuery;
      plate.hidden = !show;
      if (show) visible++;
    }
    if (empty) empty.hidden = visible > 0;
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      category = chip.dataset.category ?? "all";
      for (const other of chips) other.setAttribute("aria-pressed", String(other === chip));
      apply();
    });
  }

  search?.addEventListener("input", () => {
    query = search.value.trim().toLowerCase();
    apply();
  });

  let lastPlateOpen: HTMLButtonElement | null = null;

  for (const plate of plates) {
    const open = plate.querySelector<HTMLButtonElement>(".plate-open");
    open?.addEventListener("click", () => {
      const url = open.dataset.url;
      if (!url || !viewer || !frame) return;
      lastPlateOpen = open;
      frame.src = url;
      if (viewerTitle) viewerTitle.textContent = plate.querySelector(".plate-title")?.textContent ?? "Example";
      if (viewerSheet) viewerSheet.href = url;
      viewer.showModal();
      viewerClose?.focus();
    });
  }

  for (const img of Array.from(document.querySelectorAll<HTMLImageElement>(".plate-cover img"))) {
    img.addEventListener("error", () => {
      const cover = img.closest(".plate-cover");
      img.remove();
      if (!cover || cover.querySelector("img[data-base]")) return;
      cover.querySelectorAll("img").forEach((other) => other.remove());
    });
  }

  viewerClose?.addEventListener("click", () => viewer?.close());
  viewer?.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && event.defaultPrevented && viewer.open) viewer.close();
  });
  viewer?.addEventListener("close", () => {
    if (frame) frame.src = "about:blank";
    lastPlateOpen?.focus();
    lastPlateOpen = null;
  });
</script>
